<!DOCTYPE html>
<html lang="{{ data.meta.language if data.meta and data.meta.language else 'zh' }}">
<head>
<meta charset="UTF-8">
{%- set lang = data.meta.language if data.meta and data.meta.language else 'zh' -%}
{%- set _i18n = {
  'zh': {'title':'简历','summary':'个人简介','education':'教育经历','work':'工作经历','projects':'项目经历','research':'科研经历','skills':'专业技能','awards':'获奖与荣誉','publications':'论文与出版','languages':'语言能力','activities':'社会活动','present':'至今','rank':'排名','courses':'主修课程：','advisor':'导师：','tech':'技术栈：','sep':'、'},
  'en': {'title':'Resume','summary':'Summary','education':'Education','work':'Work Experience','projects':'Projects','research':'Research','skills':'Professional Skills','awards':'Awards & Honors','publications':'Publications','languages':'Languages','activities':'Activities','present':'Present','rank':'Rank','courses':'Courses: ','advisor':'Advisor: ','tech':'Tech: ','sep':', '},
  'zh-en': {'title':'简历 Resume','summary':'个人简介 / Summary','education':'教育经历 / Education','work':'工作经历 / Work Experience','projects':'项目经历 / Projects','research':'科研经历 / Research','skills':'专业技能 / Skills','awards':'获奖与荣誉 / Awards','publications':'论文与出版 / Publications','languages':'语言能力 / Languages','activities':'社会活动 / Activities','present':'至今','rank':'排名','courses':'主修课程：','advisor':'导师：','tech':'技术栈：','sep':'、'}
} -%}
{%- set t = _i18n[lang] if lang in _i18n else _i18n['zh'] -%}
<title>{{ data.basics.name }} - {{ t.title }}</title>
<style>
{% include 'style.css' %}
</style>
</head>
<body>
<div class="resume">

  <!-- Header -->
  <header class="header">
    <div class="header-main">
      <h1 class="name">{{ data.basics.name }}{% if data.basics.english_name %} <span class="english-name">{{ data.basics.english_name }}</span>{% endif %}</h1>
      {% if data.basics.label %}<div class="label">{{ data.basics.label }}</div>{% endif %}
      <div class="contact">
        {% if data.basics.phone %}<span>{{ data.basics.phone }}</span>{% endif %}
        {% if data.basics.email %}<span>{{ data.basics.email }}</span>{% endif %}
        {% if data.basics.location %}<span>{{ data.basics.location }}</span>{% endif %}
        {% if data.basics.website %}<span><a href="{{ data.basics.website }}">{{ data.basics.website }}</a></span>{% endif %}
      </div>
      {% if data.basics.profiles %}
      <div class="contact">
        {% for p in data.basics.profiles %}
          <span>{{ p.network }}: <a href="{{ p.url }}">{{ p.username or p.url }}</a></span>
        {% endfor %}
      </div>
      {% endif %}
      <div class="contact meta">
        {% if data.basics.gender %}<span>{{ data.basics.gender }}</span>{% endif %}
        {% if data.basics.birth %}<span>{{ data.basics.birth }}</span>{% endif %}
      </div>
    </div>
    {% if data.basics.avatar %}
    <img class="avatar" src="{{ data.basics.avatar }}" alt="avatar">
    {% endif %}
  </header>

  {% macro date_range(start, end) -%}
    {%- if start or end -%}
      <span class="date">{{ start or '' }}{% if end %} — {{ end }}{% elif start %} — {{ t.present }}{% endif %}</span>
    {%- endif -%}
  {%- endmacro %}

  {% macro highlights(items) -%}
    {% if items %}
    <ul class="highlights">
      {% for h in items %}<li>{{ h }}</li>{% endfor %}
    </ul>
    {% endif %}
  {%- endmacro %}

  {% if data.basics.summary %}
  <section class="section">
    <h2 class="section-title">{{ t.summary }}</h2>
    <p class="summary">{{ data.basics.summary }}</p>
  </section>
  {% endif %}

  {% if data.education %}
  <section class="section">
    <h2 class="section-title">{{ t.education }}</h2>
    {% for edu in data.education %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          <strong>{{ edu.institution }}</strong>
          {% if edu.area %}<span class="sep">·</span>{{ edu.area }}{% endif %}
          {% if edu.degree %}<span class="sep">·</span>{{ edu.degree }}{% endif %}
        </div>
        <div class="entry-meta">
          {% if edu.location %}<span>{{ edu.location }}</span> {% endif %}
          {{ date_range(edu.start, edu.end) }}
        </div>
      </div>
      <div class="entry-sub">
        {% if edu.gpa %}<span>GPA: {{ edu.gpa }}</span>{% endif %}
        {% if edu.rank %}<span class="sep">·</span><span>{{ t.rank }}: {{ edu.rank }}</span>{% endif %}
      </div>
      {% if edu.courses %}<div class="entry-sub">{{ t.courses }}{{ edu.courses | join(t.sep) }}</div>{% endif %}
      {{ highlights(edu.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.work %}
  <section class="section">
    <h2 class="section-title">{{ t.work }}</h2>
    {% for w in data.work %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          <strong>{{ w.organization }}</strong>
          {% if w.position %}<span class="sep">·</span>{{ w.position }}{% endif %}
          {% if w.type %}<span class="tag">{{ w.type }}</span>{% endif %}
        </div>
        <div class="entry-meta">
          {% if w.location %}<span>{{ w.location }}</span> {% endif %}
          {{ date_range(w.start, w.end) }}
        </div>
      </div>
      {% if w.summary %}<div class="entry-sub">{{ w.summary }}</div>{% endif %}
      {{ highlights(w.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.projects %}
  <section class="section">
    <h2 class="section-title">{{ t.projects }}</h2>
    {% for p in data.projects %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          <strong>{{ p.name }}</strong>
          {% if p.role %}<span class="sep">·</span>{{ p.role }}{% endif %}
          {% if p.type %}<span class="tag">{{ p.type }}</span>{% endif %}
        </div>
        <div class="entry-meta">{{ date_range(p.start, p.end) }}</div>
      </div>
      {% if p.summary %}<div class="entry-sub">{{ p.summary }}</div>{% endif %}
      {% if p.tech %}<div class="entry-sub tech">{{ t.tech }}{{ p.tech | join(' · ') }}</div>{% endif %}
      {{ highlights(p.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.research %}
  <section class="section">
    <h2 class="section-title">{{ t.research }}</h2>
    {% for r in data.research %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          <strong>{{ r.title }}</strong>
          {% if r.organization %}<span class="sep">·</span>{{ r.organization }}{% endif %}
        </div>
        <div class="entry-meta">{{ date_range(r.start, r.end) }}</div>
      </div>
      {% if r.advisor %}<div class="entry-sub">{{ t.advisor }}{{ r.advisor }}</div>{% endif %}
      {{ highlights(r.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.skills %}
  <section class="section">
    <h2 class="section-title">{{ t.skills }}</h2>
    <ul class="skill-list">
      {% for s in data.skills %}
      <li><strong>{{ s.name }}{% if s.level %}（{{ s.level }}）{% endif %}：</strong>{{ (s.keywords or []) | join(t.sep) }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if data.awards %}
  <section class="section">
    <h2 class="section-title">{{ t.awards }}</h2>
    <ul class="highlights">
      {% for a in data.awards %}
      <li><strong>{{ a.title }}</strong>{% if a.awarder %} — {{ a.awarder }}{% endif %}{% if a.date %} <span class="date">({{ a.date }})</span>{% endif %}{% if a.summary %} · {{ a.summary }}{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if data.publications %}
  <section class="section">
    <h2 class="section-title">{{ t.publications }}</h2>
    <ul class="highlights">
      {% for p in data.publications %}
      <li><strong>{{ p.name }}</strong>{% if p.publisher %}. {{ p.publisher }}{% endif %}{% if p.release_date %} ({{ p.release_date }}){% endif %}{% if p.summary %} — {{ p.summary }}{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if data.languages %}
  <section class="section">
    <h2 class="section-title">{{ t.languages }}</h2>
    <ul class="skill-list">
      {% for l in data.languages %}
      <li>{{ l.language }}{% if l.level %}：{{ l.level }}{% endif %}{% if l.score %} ({{ l.score }}){% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if data.activities %}
  <section class="section">
    <h2 class="section-title">{{ t.activities }}</h2>
    {% for a in data.activities %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title"><strong>{{ a.organization }}</strong>{% if a.role %}<span class="sep">·</span>{{ a.role }}{% endif %}</div>
        <div class="entry-meta">{{ date_range(a.start, a.end) }}</div>
      </div>
      {{ highlights(a.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.custom_sections %}
    {% for cs in data.custom_sections %}
    <section class="section">
      <h2 class="section-title">{{ cs.title }}</h2>
      {% for it in cs['items'] or [] %}
      <div class="entry">
        {% if it.heading or it.subheading or it.date %}
        <div class="entry-head">
          <div class="entry-title">
            {% if it.heading %}<strong>{{ it.heading }}</strong>{% endif %}
            {% if it.subheading %}<span class="sep">·</span>{{ it.subheading }}{% endif %}
          </div>
          {% if it.date %}<div class="entry-meta"><span class="date">{{ it.date }}</span></div>{% endif %}
        </div>
        {% endif %}
        {% if it.summary %}<div class="entry-sub">{{ it.summary }}</div>{% endif %}
        {{ highlights(it.highlights) }}
      </div>
      {% endfor %}
    </section>
    {% endfor %}
  {% endif %}

</div>
</body>
</html>
