<!DOCTYPE html>
<html lang="{{ data.meta.language if data.meta and data.meta.language else 'zh' }}">
<head>
<meta charset="UTF-8">
{%- set lang = data.meta.language if data.meta and data.meta.language else 'zh' -%}
{%- set _i18n = {
  'zh': {'title':'简历','summary':'个人简介','education':'教育经历','work':'工作经历','projects':'项目经历','research':'科研经历','skills':'技能','awards':'获奖与荣誉','publications':'论文/出版','languages':'语言','activities':'组织/志愿经历','present':'至今','rank':'排名','advisor':'导师：','contact':'联系方式','profiles':'社交主页','sep':'、'},
  'en': {'title':'Resume','summary':'Summary','education':'Education','work':'Work Experience','projects':'Projects','research':'Research','skills':'Skills','awards':'Awards & Honors','publications':'Publications','languages':'Languages','activities':'Activities','present':'Present','rank':'Rank','advisor':'Advisor: ','contact':'Contact','profiles':'Profiles','sep':', '},
  'zh-en': {'title':'简历 Resume','summary':'个人简介 / Summary','education':'教育经历 / Education','work':'工作经历 / Work Experience','projects':'项目经历 / Projects','research':'科研经历 / Research','skills':'技能 / Skills','awards':'获奖与荣誉 / Awards','publications':'论文/出版 / Publications','languages':'语言 / Languages','activities':'组织/志愿经历 / Activities','present':'至今','rank':'排名','advisor':'导师：','contact':'联系方式 Contact','profiles':'社交主页 Profiles','sep':'、'}
} -%}
{%- set t = _i18n[lang] if lang in _i18n else _i18n['zh'] -%}
<title>{{ data.basics.name }} - {{ t.title }}</title>
<style>
{% include 'style.css' %}
</style>
</head>
<body>
<div class="resume">

  <!-- Left Panel -->
  <aside class="panel-left">
    {% if data.basics.avatar %}
    <img class="avatar" src="{{ data.basics.avatar }}" alt="avatar">
    {% endif %}
    <h1 class="name">{{ data.basics.name }}</h1>
    {% if data.basics.english_name %}<span class="english-name">{{ data.basics.english_name }}</span>{% endif %}
    {% if data.basics.label %}<div class="label">{{ data.basics.label }}</div>{% endif %}

    <div class="panel-section">
      <h3 class="panel-title">{{ t.contact }}</h3>
      <ul class="contact-list">
        {% if data.basics.phone %}<li>📞 {{ data.basics.phone }}</li>{% endif %}
        {% if data.basics.email %}<li>✉️ {{ data.basics.email }}</li>{% endif %}
        {% if data.basics.location %}<li>📍 {{ data.basics.location }}</li>{% endif %}
        {% if data.basics.website %}<li>🌐 {{ data.basics.website }}</li>{% endif %}
        {% if data.basics.gender %}<li>👤 {{ data.basics.gender }}</li>{% endif %}
        {% if data.basics.birth %}<li>🎂 {{ data.basics.birth }}</li>{% endif %}
      </ul>
    </div>

    {% if data.basics.profiles %}
    <div class="panel-section">
      <h3 class="panel-title">{{ t.profiles }}</h3>
      <ul class="contact-list">
        {% for p in data.basics.profiles %}
        <li><a href="{{ p.url }}">{{ p.network }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if data.skills %}
    <div class="panel-section">
      <h3 class="panel-title">{{ t.skills }}</h3>
      {% for s in data.skills %}
      <div class="skill-bar-group">
        <div class="skill-bar-label">{{ s.name }}</div>
        {% if s.level %}
        <div class="skill-bar">
          <div class="skill-bar-fill" style="width: {% if s.level == '精通' or s.level == 'Expert' %}95%{% elif s.level == '熟练' or s.level == 'Advanced' %}80%{% elif s.level == '熟悉' or s.level == 'Intermediate' %}60%{% else %}45%{% endif %}"></div>
        </div>
        {% endif %}
        {% if s.keywords %}
        <ul class="skill-keywords-list">
          {% for kw in s.keywords %}<li>{{ kw }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if data.languages %}
    <div class="panel-section">
      <h3 class="panel-title">{{ t.languages }}</h3>
      {% for l in data.languages %}
      <div class="lang-item">
        <span>{{ l.language }}</span>
        <span class="lang-level">{{ l.level or l.score or '' }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </aside>

  <!-- Right Panel -->
  <div class="panel-right">

  {% macro date_range(start, end) -%}
    {%- if start or end -%}
      <span class="date">{{ start or '' }}{% if end %} — {{ end }}{% elif start %} — {{ t.present }}{% endif %}</span>
    {%- endif -%}
  {%- endmacro %}

  {% macro highlights(items) -%}
    {% if items %}
    <ul class="highlights">
      {% for h in items %}<li>{{ h }}</li>{% endfor %}
    </ul>
    {% endif %}
  {%- endmacro %}

  {% if data.basics.summary %}
  <section class="section">
    <h2 class="section-title"><span class="section-icon">💡</span>{{ t.summary }}</h2>
    <p class="summary">{{ data.basics.summary }}</p>
  </section>
  {% endif %}

  {% if data.education %}
  <section class="section">
    <h2 class="section-title"><span class="section-icon">🎓</span>{{ t.education }}</h2>
    {% for edu in data.education %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          <strong>{{ edu.institution }}</strong>
          {% if edu.area %}<span class="sep">·</span>{{ edu.area }}{% endif %}
          {% if edu.degree %}<span class="sep">·</span>{{ edu.degree }}{% endif %}
        </div>
        <div class="entry-meta">{{ date_range(edu.start, edu.end) }}</div>
      </div>
      <div class="entry-sub">
        {% if edu.gpa %}<span>GPA: {{ edu.gpa }}</span>{% endif %}
        {% if edu.rank %}<span class="sep">·</span>{{ t.rank }}: {{ edu.rank }}{% endif %}
      </div>
      {% if edu.courses %}<div class="entry-sub">{{ edu.courses | join(t.sep) }}</div>{% endif %}
      {{ highlights(edu.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.work %}
  <section class="section">
    <h2 class="section-title"><span class="section-icon">💼</span>{{ t.work }}</h2>
    {% for w in data.work %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          <strong>{{ w.organization }}</strong>
          {% if w.position %}<span class="sep">·</span>{{ w.position }}{% endif %}
          {% if w.type %}<span class="tag">{{ w.type }}</span>{% endif %}
        </div>
        <div class="entry-meta">
          {% if w.location %}<span>{{ w.location }}</span> {% endif %}
          {{ date_range(w.start, w.end) }}
        </div>
      </div>
      {% if w.summary %}<div class="entry-sub">{{ w.summary }}</div>{% endif %}
      {{ highlights(w.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.projects %}
  <section class="section">
    <h2 class="section-title"><span class="section-icon">🚀</span>{{ t.projects }}</h2>
    {% for p in data.projects %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          <strong>{{ p.name }}</strong>
          {% if p.role %}<span class="sep">·</span>{{ p.role }}{% endif %}
          {% if p.type %}<span class="tag">{{ p.type }}</span>{% endif %}
        </div>
        <div class="entry-meta">{{ date_range(p.start, p.end) }}</div>
      </div>
      {% if p.summary %}<div class="entry-sub">{{ p.summary }}</div>{% endif %}
      {% if p.tech %}<div class="entry-sub tech">{{ p.tech | join(' · ') }}</div>{% endif %}
      {{ highlights(p.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.research %}
  <section class="section">
    <h2 class="section-title"><span class="section-icon">🔬</span>{{ t.research }}</h2>
    {% for r in data.research %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          <strong>{{ r.title }}</strong>
          {% if r.organization %}<span class="sep">·</span>{{ r.organization }}{% endif %}
        </div>
        <div class="entry-meta">{{ date_range(r.start, r.end) }}</div>
      </div>
      {% if r.advisor %}<div class="entry-sub">{{ t.advisor }}{{ r.advisor }}</div>{% endif %}
      {{ highlights(r.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.awards %}
  <section class="section">
    <h2 class="section-title"><span class="section-icon">🏆</span>{{ t.awards }}</h2>
    <ul class="highlights">
      {% for a in data.awards %}
      <li><strong>{{ a.title }}</strong>{% if a.awarder %} — {{ a.awarder }}{% endif %}{% if a.date %} <span class="date">({{ a.date }})</span>{% endif %}{% if a.summary %} · {{ a.summary }}{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if data.publications %}
  <section class="section">
    <h2 class="section-title"><span class="section-icon">📝</span>{{ t.publications }}</h2>
    <ul class="highlights">
      {% for p in data.publications %}
      <li><strong>{{ p.name }}</strong>{% if p.publisher %}. {{ p.publisher }}{% endif %}{% if p.release_date %} ({{ p.release_date }}){% endif %}{% if p.summary %} — {{ p.summary }}{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if data.activities %}
  <section class="section">
    <h2 class="section-title"><span class="section-icon">🤝</span>{{ t.activities }}</h2>
    {% for a in data.activities %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title"><strong>{{ a.organization }}</strong>{% if a.role %}<span class="sep">·</span>{{ a.role }}{% endif %}</div>
        <div class="entry-meta">{{ date_range(a.start, a.end) }}</div>
      </div>
      {{ highlights(a.highlights) }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if data.custom_sections %}
    {% for cs in data.custom_sections %}
    <section class="section">
      <h2 class="section-title">{{ cs.title }}</h2>
      {% for it in cs['items'] or [] %}
      <div class="entry">
        {% if it.heading or it.subheading or it.date %}
        <div class="entry-head">
          <div class="entry-title">
            {% if it.heading %}<strong>{{ it.heading }}</strong>{% endif %}
            {% if it.subheading %}<span class="sep">·</span>{{ it.subheading }}{% endif %}
          </div>
          {% if it.date %}<div class="entry-meta"><span class="date">{{ it.date }}</span></div>{% endif %}
        </div>
        {% endif %}
        {% if it.summary %}<div class="entry-sub">{{ it.summary }}</div>{% endif %}
        {{ highlights(it.highlights) }}
      </div>
      {% endfor %}
    </section>
    {% endfor %}
  {% endif %}

  </div>
</div>
</body>
</html>
